    "id": "Q01",
    "question": "Why does the JazzCash payment callback handler throw a timeout error during peak traffic?",
    "expected_symbols": [
      "data/sample_codebase/api/routes/jazzcash_callback.py::handle_jazzcash_callback",
      "data/sample_codebase/auth/webhook_verification.py::verify_webhook_signature",
      "data/sample_codebase/services/payment_service.py::PaymentService.process_jazzcash_callback",
      "data/sample_codebase/db/repository.py::PaymentRepository.acquire_account_lock",
      "data/sample_codebase/integrations/onelink_client.py::OneLinkSwitchClient.verify_switch_transaction"
    ],
    "expected_files": [
      "data/sample_codebase/api/routes/jazzcash_callback.py",
      "data/sample_codebase/auth/webhook_verification.py",
      "data/sample_codebase/services/payment_service.py",
      "data/sample_codebase/db/repository.py",
      "data/sample_codebase/integrations/onelink_client.py"
    ],
    "expected_call_path": [
      "data/sample_codebase/api/routes/jazzcash_callback.py::handle_jazzcash_callback",
      "data/sample_codebase/auth/webhook_verification.py::verify_webhook_signature",
      "data/sample_codebase/services/payment_service.py::PaymentService.process_jazzcash_callback",
      "data/sample_codebase/db/repository.py::PaymentRepository.acquire_account_lock",
      "data/sample_codebase/integrations/onelink_client.py::OneLinkSwitchClient.verify_switch_transaction"
    ],
    "answer_facts": [
      "The callback handler verifies the webhook signature before processing the payment.",
      "process_jazzcash_callback acquires an exclusive merchant account row lock.",
      "The 1LINK verification call executes while the database row lock is still held.",
      "Peak 1LINK latency can keep the lock held long enough for concurrent callbacks to hit the database lock timeout.",
      "The resulting request can exceed the API gateway timeout and return HTTP 504."
    ]
  },
