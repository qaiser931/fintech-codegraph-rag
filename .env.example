# ==========================================
# Fintech CodeGraph RAG Configuration
# ==========================================

# LLM Provider Configuration (Required for Phase 6+ answer generation)
OPENAI_API_KEY=
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b
LLM_TEMPERATURE=0.0

# Embedding & Reranking Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage & Persistence Paths
VECTOR_DB_PATH=data/vector_store
GRAPH_STORE_PATH=data/graph_index/codebase_graph.json
BM25_STORE_PATH=data/bm25_index/bm25_index.pkl

# Security & RBAC
DEFAULT_TENANT_ID=fintech-pk-corp
ALLOWED_ROLES=["Junior Dev", "Senior Dev", "Security Lead"]
# Optional JSON map from bearer tokens to roles; keep real tokens in .env.
API_ROLE_TOKENS={}
# Example when remote API access is intentionally enabled:
# API_ROLE_TOKENS={"replace-with-random-token":"Junior Dev"}

# Telemetry & Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
TELEMETRY_LOG_DIR=telemetry_logs

# Local Ollama defaults; real credentials belong in .env only.
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_READ_TIMEOUT=180
