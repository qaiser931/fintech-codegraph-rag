# Stackwise server-only configuration. Never commit real values.
# Connect a managed Postgres integration through the Vercel Marketplace.
DATABASE_URL=
STACKWISE_APP_URL=https://fintech-codegraph-rag.vercel.app
# Generate these privately with scripts/stackwise_private_settings.py.
STACKWISE_ADMIN_TOKEN=
STACKWISE_ENCRYPTION_KEY=
CRON_SECRET=
STACKWISE_QUEUE_ENABLED=1
STACKWISE_QUEUE_REGION=iad1
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# GitHub OAuth configuration (create an OAuth App at GitHub Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: Comma-separated GitHub logins who receive the 'owner' role (e.g. qaiser931). If empty, any authenticated user receives 'owner'.
# GITHUB_ADMIN_USERS=
# Local development only; never set this on Vercel.
# STACKWISE_LOCAL=1

