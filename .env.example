# Local loopback development example. Keep real credentials in .env only.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=180
API_ROLE_TOKENS={}
# An authenticated deployment needs unique secret tokens for each UI role.
# Existing Docker deployment uses its own .env with the container-reachable host.
